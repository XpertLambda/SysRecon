{
    "general": {
        "verbose_output": false,
        "stealth_mode": false,
        "require_admin": true
    },
    "modules": {
        "accounts": {
            "enabled": true,
            "enumerate_groups": true
        },
        "services": {
            "enabled": true
        },
        "processes": {
            "enabled": true,
            "check_dlls": true
        },
        "network": {
            "enabled": true,
            "scan_listening_ports": true,
            "analyze_connections": true
        },
        "registry": {
            "enabled": true,
            "scan_startup_keys": true,
            "analyze_policies": true,
            "check_permissions": true,
            "custom_keys": []
        },
        "memory": {
            "enabled": false,
            "create_dumps": false,
            "scan_for_malware": true,
            "max_dump_size_mb": 100
        },
        "privesc": {
            "enabled": true,
            "check_services": true,
            "check_registry": true,
            "check_filesystem": true,
            "check_credentials": true,
            "verify_signatures": true,
            "check_tokens": true,
            "check_scheduled_tasks": true,
            "check_patches": true,
            "check_defender": true,
            "check_hardening": true
        }
    },
    "output": {
        "output_directory": "./reports",
        "generate_json": true,
        "generate_csv": true,
        "generate_html": true
    }
}
